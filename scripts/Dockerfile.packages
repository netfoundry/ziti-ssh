# Pinned by digest (multi-arch index); Dependabot (docker ecosystem) updates it.
FROM golang:1.27-bookworm@sha256:4fa7c968ba93f1635670522dbb01a2c78150443e1385746924566079f36570ea

ARG VERSION=0.1.0
ARG FORMAT=deb,rpm
ARG ARCHS=amd64

ENV VERSION=${VERSION} FORMAT=${FORMAT} ARCHS=${ARCHS}

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .

RUN scripts/build-packages.sh
