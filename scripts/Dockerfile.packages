FROM golang:1.25-bookworm

ARG VERSION=0.1.0
ARG FORMAT=deb,rpm
ARG ARCHS=amd64

ENV VERSION=${VERSION} FORMAT=${FORMAT} ARCHS=${ARCHS}

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .

RUN scripts/build-packages.sh
