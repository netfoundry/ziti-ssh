# Pinned by digest (multi-arch index); Dependabot (docker ecosystem) updates it.
FROM golang:1.26-bookworm@sha256:dc40a13b61304647ed7e5d581d246b86413dfc29d63c6d018310feb93cd98fc0

ARG VERSION=0.1.0
ARG FORMAT=deb,rpm
ARG ARCHS=amd64

ENV VERSION=${VERSION} FORMAT=${FORMAT} ARCHS=${ARCHS}

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .

RUN scripts/build-packages.sh
